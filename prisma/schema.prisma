generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Subscription {
  // We key by Clerk userId — one Clerk account = one Polykit subscription.
  userId              String   @id @map("user_id")

  // Whop fields (active payment system).
  whopMembershipId    String?  @unique @map("whop_membership_id")
  whopUserId          String?  @map("whop_user_id")
  whopPlanId          String?  @map("whop_plan_id")
  // URL the customer visits to manage/cancel their subscription on Whop.
  // Captured from the webhook payload; falls back to a constructed URL.
  whopManageUrl       String?  @map("whop_manage_url")
  email               String?

  // active | canceled | expired | past_due | trialing
  status              String?

  // When access ends — used to grant access even after `canceled` until the
  // paid period runs out.
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz

  // Legacy Stripe fields (kept so old data isn't lost; safe to drop later).
  stripeCustomerId    String?  @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  currentPeriodEnd    DateTime? @map("current_period_end") @db.Timestamptz

  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([email])
  @@map("subscriptions")
}

model Position {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id")
  marketQuestion String   @map("market_question")
  marketSlug     String?  @map("market_slug")
  eventSlug      String?  @map("event_slug")
  side           String   // YES or NO
  entryPrice     Decimal  @map("entry_price") @db.Decimal
  exitPrice      Decimal? @map("exit_price") @db.Decimal
  size           Decimal  @db.Decimal
  status         String   @default("open") // open | closed
  pnl            Decimal  @default(0) @db.Decimal
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  @@index([userId, status])
  @@map("positions")
}

model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  // Nullable so anonymous visitors can join the public launch waitlist.
  userId    String?  @map("user_id")
  email     String
  feature   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@unique([email, feature])
  @@map("waitlist_entries")
}

model TrackedWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  address   String
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@unique([userId, address])
  @@map("tracked_wallets")
}

model Pick {
  id             String   @id @default(uuid()) @db.Uuid
  marketQuestion String   @map("market_question")
  slug           String?
  eventSlug      String?  @map("event_slug")
  side           String?
  price          Decimal? @db.Decimal
  confidence     Int?
  rationale      String?
  imageUrl       String?  @map("image_url")
  volumeUsd      Decimal? @map("volume_usd") @db.Decimal
  liquidityUsd   Decimal? @map("liquidity_usd") @db.Decimal
  endsAt         DateTime? @map("ends_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("picks")
}

model CoachMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  role      String   // user | assistant
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId, createdAt])
  @@map("coach_messages")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id")
  name       String    @default("Default")
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId])
  @@map("api_keys")
}

model McpToolCall {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  apiKeyId     String?  @map("api_key_id") @db.Uuid
  tool         String
  status       String   // ok | error
  latencyMs    Int?     @map("latency_ms")
  inputSummary String?  @map("input_summary")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId, createdAt])
  @@map("mcp_tool_calls")
}

// ─────────────────────────────────────────────────────────────
// OAuth 2.1 authorization server — lets MCP clients that only
// speak OAuth (Claude.ai custom connectors) sign the user in
// through Clerk instead of pasting a connection key.
// ─────────────────────────────────────────────────────────────

model OAuthClient {
  // Public client id we hand back from dynamic client registration.
  clientId     String   @id @map("client_id")
  clientName   String?  @map("client_name")
  redirectUris String[] @map("redirect_uris")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("oauth_clients")
}

model OAuthCode {
  // Authorization code, stored hashed — it is a bearer credential.
  codeHash            String   @id @map("code_hash")
  clientId            String   @map("client_id")
  userId              String   @map("user_id")
  redirectUri         String   @map("redirect_uri")
  // PKCE. S256 only; we reject plain.
  codeChallenge       String   @map("code_challenge")
  codeChallengeMethod String   @default("S256") @map("code_challenge_method")
  scope               String   @default("analyze")
  resource            String?
  expiresAt           DateTime @map("expires_at") @db.Timestamptz
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId])
  @@map("oauth_codes")
}

model OAuthToken {
  id           String    @id @default(uuid()) @db.Uuid
  // Both access and refresh tokens are stored hashed.
  tokenHash    String    @unique @map("token_hash")
  // access | refresh
  tokenType    String    @map("token_type")
  clientId     String    @map("client_id")
  userId       String    @map("user_id")
  scope        String    @default("analyze")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId])
  @@index([tokenType, expiresAt])
  @@map("oauth_tokens")
}
